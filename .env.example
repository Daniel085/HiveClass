# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Google OAuth client (required to sign in).
# Create one at https://console.cloud.google.com/apis/credentials
#   Type: Web application
#   Authorized redirect URI: http://localhost:8080/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email domains allowed to sign in, as a JSON array.
# gmail.com lets any personal Google account in, which is fine locally.
DEV_WHITELIST_DOMAINS=["gmail.com"]

# Signs session cookies; shared by auth, apps and storage. 32+ characters.
# The built-in default is for local development only.
# COOKIE_PASSWORD=

# Token for the /auth/whitelist admin API. Default: local_token
# ADMIN_BEARER_TOKEN=

# Only needed if the Jira feedback proxy is used: 'Basic <base64 user:pass>'
# JIRA_AUTHORIZATION=
